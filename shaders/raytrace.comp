#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba32f, set = 0, binding = 0) uniform image2D accumImage;
layout(rgba8, set = 0, binding = 6) uniform image2D displayImage;


struct Vertex {
    float position[3];
    float normal[3];
    float uv[2];
};

struct Triangle {
    uint v0;
    uint v1;
    uint v2;
